rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isAuthenticated() && getUserData().role == 'owner';
    }

    function isWorker() {
      return isAuthenticated() && (getUserData().role == 'worker' || getUserData().role == 'owner');
    }

    // Products collection:
    // Anyone (customers) can read products.
    // Workers & Owners can update stock or edit; Owners can delete or create products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isWorker();
    }

    // Orders collection:
    // Anyone can create an order (public storefront checkout).
    // Only staff (workers and owners) can read, update status, or fulfill orders.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isWorker();
      allow delete: if isOwner();
    }

    // Expenses collection (BMS financial ledger):
    // Strictly confidential: Only owners can read or write expenses.
    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    // Users collection:
    // Authenticated users can read their own profile.
    // If no users exist yet or during first-time setup, anyone can initialize the first owner account.
    // Only owners can create or edit other staff accounts.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow update, delete: if isOwner();
    }

    // Audit logs & Settings:
    match /audit_logs/{logId} {
      allow read, create: if isWorker();
      allow update, delete: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
