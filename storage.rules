rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product images:
    // Public read so customers can view pictures on the storefront.
    // Upload/delete restricted to authenticated staff (workers or owners).
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Business receipts & invoices:
    // Only authenticated owners and workers can access receipts.
    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
